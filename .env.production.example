# ==============================================================================
# Production Environment Variables for Medusa v2 Backend (GCP VM + Neon.tech)
# Rename or copy to .env on your GCP VM instance
# ==============================================================================

NODE_ENV=production
PORT=9000

# 1. Database (Neon.tech connection string with sslmode=require)
DATABASE_URL=postgres://USER:PASSWORD@ep-XYZ.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL=true

# 2. Redis (Optional - Medusa v2 falls back to in-memory/in-database if omitted)
# REDIS_URL=redis://localhost:6379

# 3. Security Secrets (Generate random 32-char strings)
JWT_SECRET=super_secret_jwt_key_change_me_12345
COOKIE_SECRET=super_secret_cookie_key_change_me_12345

# 4. CORS Origins (Set to your Vercel URL & GCP VM IP or domain)
STORE_CORS=https://your-app.vercel.app,http://localhost:3000
ADMIN_CORS=http://YOUR_GCP_VM_IP,https://your-app.vercel.app,http://localhost:7001
AUTH_CORS=https://your-app.vercel.app,http://YOUR_GCP_VM_IP,http://localhost:3000

# 5. Sanity CMS (Same credentials as local)
SANITY_PROJECT_ID=plyu49lt
SANITY_DATASET=production

# 6. Google Auth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://api.arohahouse.com/auth/customer/google/callback
