# ==============================================================================
# Aroha House Medusa v2 Backend - Environment Variables Template
# All secrets and external service configs should use empty placeholders here.
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=9000
HOST=0.0.0.0
MEDUSA_WORKER_MODE=shared

# Database (Neon PostgreSQL)
DATABASE_URL=
DATABASE_SSL=true

# Redis (Optional)
REDIS_URL=

# Authentication & Security Secrets
JWT_SECRET=
COOKIE_SECRET=
COOKIE_SECURE=true

# CORS Configuration
STORE_CORS=
ADMIN_CORS=
AUTH_CORS=

# File Storage (Cloudflare R2 via S3 API)
FILE_BASE_URL=
R2_PUBLIC_BASE_URL=
R2_RAW_PREFIX=raw/
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Sanity CMS
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_STUDIO_URL=

# Resend Email Notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Search (Meilisearch / Algolia)
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=
MEILISEARCH_PRODUCT_INDEX_NAME=products
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=
ALGOLIA_PRODUCT_INDEX_NAME=products

# Image Conversion Dispatch (GitHub Actions)
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=
GITHUB_API_URL=https://api.github.com
GITHUB_DISPATCH_EVENT=image_conversion
IMAGE_CONVERSION_RAW_PREFIX=raw/

# Social Auth Providers (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
